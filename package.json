{
  "name": "clamps-vscode",
  "displayName": "CLAMPS",
  "description": "CLAMPS-Sprachunterstützung für VS Code über LSP (Swank-Bridge)",
  "version": "0.0.1",
  "publisher": "local-dev",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:lisp",
    "onCommand:clamps.openRepl",
    "onCommand:clamps.macroexpand",
    "onCommand:clamps.macroexpandAll",
    "onCommand:clamps.openGui",
    "onCommand:clamps.disassemble",
    "onCommand:clamps.inspect",
    "onCommand:clamps.evalTopLevel",
    "onCommand:clamps.toggleTrace",
    "onCommand:clamps.untraceAll",
    "onDebug",
    "onCommand:clamps.debugAttach"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clamps.start",
        "title": "CLAMPS: Start"
      },
      {
        "command": "clamps.stop",
        "title": "CLAMPS: Stop"
      },
      {
        "command": "clamps.restart",
        "title": "CLAMPS: Restart"
      },
      {
        "command": "clamps.openRepl",
        "title": "CLAMPS: Open REPL"
      },
      {
        "command": "clamps.evalSelection",
        "title": "CLAMPS: Evaluate Selection or Line"
      },
      {
        "command": "clamps.evalFile",
        "title": "CLAMPS: Evaluate File"
      },
      {
        "command": "clamps.macroexpand",
        "title": "CLAMPS: Macroexpand-1 (eine Ebene)"
      },
      {
        "command": "clamps.macroexpandAll",
        "title": "CLAMPS: Macroexpand (vollständig)"
      },
      {
        "command": "clamps.openGui",
        "title": "CLAMPS: GUI öffnen (ATS Explorer)"
      },
      {
        "command": "clamps.disassemble",
        "title": "CLAMPS: Disassemble (Maschinencode)"
      },
      {
        "command": "clamps.inspect",
        "title": "CLAMPS: Inspect (Objekt-Inspektor)"
      },
      {
        "command": "clamps.evalTopLevel",
        "title": "CLAMPS: Evaluate Top-Level Form"
      },
      {
        "command": "clamps.evalLastExpression",
        "title": "CLAMPS: Evaluate Last Expression"
      },
      {
        "command": "clamps.toggleTrace",
        "title": "CLAMPS: Toggle Trace (Funktion tracen)"
      },
      {
        "command": "clamps.untraceAll",
        "title": "CLAMPS: Untrace All (alle Traces aus)"
      },
      {
        "command": "clamps.rtStatusDetails",
        "title": "CLAMPS: DSP-Status anzeigen"
      },
      {
        "command": "clamps.debugAttach",
        "title": "CLAMPS: Debugger anhängen"
      },
      {
        "command": "clamps.debugRestarts",
        "title": "CLAMPS: Restart auswählen"
      },
      {
        "command": "clamps.debugInspectCondition",
        "title": "CLAMPS: Condition inspizieren"
      },
      {
        "command": "clamps.debugInspectVariable",
        "title": "CLAMPS: Wert inspizieren"
      },
      {
        "command": "clamps.debugAbortAll",
        "title": "CLAMPS: Alle Debugger-Ebenen verlassen"
      }
    ],
    "languages": [
      {
        "id": "lisp",
        "extensions": [
          ".lisp",
          ".cl",
          ".asd"
        ],
        "aliases": [
          "Common Lisp",
          "lisp"
        ]
      }
    ],
    "keybindings": [
      {
        "command": "clamps.evalLastExpression",
        "key": "ctrl+x ctrl+e",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalLastExpression",
        "key": "ctrl+c ctrl+e",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalTopLevel",
        "key": "ctrl+c ctrl+c",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalTopLevel",
        "key": "ctrl+alt+x",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalFile",
        "key": "ctrl+c ctrl+k",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.macroexpand",
        "key": "ctrl+c ctrl+m",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.inspect",
        "key": "ctrl+c ctrl+i",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.disassemble",
        "key": "ctrl+c alt+d",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.openRepl",
        "key": "ctrl+c ctrl+z",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.toggleTrace",
        "key": "ctrl+c ctrl+t",
        "when": "editorTextFocus && editorLangId == lisp"
      }
    ],
    "configuration": {
      "title": "CLAMPS",
      "properties": {
        "clamps.guiPort": {
          "type": "number",
          "default": 54619,
          "description": "Port des CLAMPS-GUI-Webservers (clamps-start :port). Default 54619."
        },
        "clamps.rtPollInterval": {
          "type": "number",
          "default": 3000,
          "description": "Abstand in Millisekunden, in dem der DSP-Status in der Statusleiste aktualisiert wird. 0 schaltet das Polling ab."
        },
        "clamps.debugTrace": {
          "type": "boolean",
          "default": false,
          "description": "Schreibt den rohen Swank-Verkehr der Debug-Session in die Debug-Konsole. Nur zur Fehlersuche."
        },
        "clamps.replUsesDebugger": {
          "type": "boolean",
          "default": false,
          "description": "Wertet REPL-Eingaben über die Verbindung des Debug-Adapters aus, damit Fehler den Lisp-Debugger öffnen. Experimentell — ohne angehängten Debugger ohne Wirkung."
        }
      }
    },
    "debuggers": [
      {
        "type": "clamps",
        "label": "CLAMPS (Common Lisp)",
        "languages": [
          "lisp"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {}
          }
        },
        "initialConfigurations": [
          {
            "type": "clamps",
            "request": "attach",
            "name": "CLAMPS: Debugger anhängen"
          }
        ]
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "clamps.debugInspectVariable",
          "when": "debugType == clamps",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "clamps.debugInspectVariable",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85",
    "typescript": "5.4"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
