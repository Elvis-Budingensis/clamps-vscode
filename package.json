      },
      {
        "command": "clamps.asdf.load",
        "title": "CLAMPS ASDF: Load System"
      },
      {
        "command": "clamps.asdf.compile",
        "title": "CLAMPS ASDF: Compile System"
      },
      {
        "command": "clamps.asdf.test",
        "title": "CLAMPS ASDF: Test System"
      },
      {
        "command": "clamps.inspectPresentation",
        "title": "CLAMPS: Inspect REPL Result"
      },
      {
        "command": "clamps.macrostep",
        "title": "CLAMPS: Macrostep"
      },
      {
        "command": "clamps.stickerWrap",
        "title": "CLAMPS: Instrument Expression as Sticker"
      },
      {
        "command": "clamps.stickersShow",
        "title": "CLAMPS: Show Stickers"
      },
      {
        "command": "clamps.stickersClear",
        "title": "CLAMPS: Clear Stickers"
      },
      {
        "command": "clamps.meterShow",
        "title": "CLAMPS: Show Levels"
      },
      {
        "command": "clamps.freqScopeShow",
        "title": "CLAMPS: Show Spectrum (Freq Scope)"
      },
      {
        "command": "clamps.spectrogramShow",
        "title": "CLAMPS: Show Spectrogram (frequency over time)"
      },
      {
        "command": "clamps.bufferShow",
        "title": "CLAMPS: Show Buffer Waveform"
      },
      {
        "command": "clamps.atsShow",
        "title": "CLAMPS: Show ATS Analysis"
      }
    ],
    "languages": [
      {
        "id": "lisp",
        "extensions": [
          ".lisp",
          ".cl",
          ".asd",
          ".lsp"
        ],
        "aliases": [
          "Common Lisp",
          "lisp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "keybindings": [
      {
        "command": "clamps.evalLastExpression",
        "key": "ctrl+x ctrl+e",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalLastExpression",
        "key": "ctrl+c ctrl+e",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalTopLevel",
        "key": "ctrl+c ctrl+c",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalTopLevel",
        "key": "ctrl+alt+x",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.evalFile",
        "key": "ctrl+c ctrl+k",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.macroexpand",
        "key": "ctrl+c ctrl+m",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.inspect",
        "key": "ctrl+c ctrl+i",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.disassemble",
        "key": "ctrl+c alt+d",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.openRepl",
        "key": "ctrl+c ctrl+z",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.toggleTrace",
        "key": "ctrl+c ctrl+t",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.closeParens",
        "key": "ctrl+c ctrl+]",
        "when": "editorTextFocus && editorLangId == lisp"
      },
      {
        "command": "clamps.xrefBack",
        "key": "alt+-",
        "when": "editorTextFocus && (editorLangId == lisp || editorLangId == commonlisp)"
      },
      {
        "command": "clamps.xrefForward",
        "key": "alt+shift+-",
        "when": "editorTextFocus && (editorLangId == lisp || editorLangId == commonlisp)"
      }
    ],
    "configurationDefaults": {
      "[lisp]": {
        "editor.formatOnType": true
      },
      "[commonlisp]": {
        "editor.formatOnType": true
      }
    },
    "configuration": {
      "title": "CLAMPS",
      "properties": {
        "clamps.guiPort": {
          "type": "number",
          "default": 54619,
          "description": "Port of the CLAMPS GUI web server (clamps-start :port). Default 54619."
        },
        "clamps.rtPollInterval": {
          "type": "number",
          "default": 3000,
          "description": "Interval in milliseconds at which the DSP status in the status bar is refreshed. 0 turns polling off."
        },
        "clamps.debugTrace": {
          "type": "boolean",
          "default": false,
          "description": "Writes the raw Swank traffic of the debug session to the debug console. For troubleshooting only."
        },
        "clamps.replUsesDebugger": {
          "type": "boolean",
          "default": true,
          "description": "Evaluates REPL input over the debug adapter connection, so that errors open the Lisp debugger. Experimental — without an attached debugger it has no effect."
        },
        "clamps.autoAttachDebugger": {
          "type": "boolean",
          "default": true,
          "description": "Attaches the Lisp debugger automatically as soon as CLAMPS starts, so that errors end up in the debugger without hooking in by hand."
        },
        "clamps.meterIntervalMs": {
          "type": "number",
          "default": 100,
          "minimum": 20,
          "description": "Fetch interval of the level meter in milliseconds. Smaller means smoother and more traffic over the bridge; below the ring’s decimation window it gains nothing, because there is nothing new to fetch."
        },
        "clamps.freqScopeIntervalMs": {
          "type": "number",
          "default": 50,
          "minimum": 20,
          "description": "Frame interval of the freq scope in milliseconds. Every frame is a full FFT in the Lisp image — 50 ms is 20 frames per second and ample for a spectrum. Hidden windows do not run the cycle."
        },
        "clamps.freqScopeFftSize": {
          "type": "number",
          "default": 2048,
          "enum": [
            256,
            512,
            1024,
            2048,
            4096,
            8192
          ],
          "description": "Default FFT length of the freq scope. Long means fine frequency resolution and sluggish time resolution: at 48 kHz, 2048 points give 23.4 Hz per bin over a window of 43 ms. The ring must hold at least that many values."
        },
        "clamps.spectrogramIntervalMs": {
          "type": "number",
          "default": 60,
          "minimum": 20,
          "description": "Request interval of the spectrogram in milliseconds. This is NOT the time resolution: the frames sit on an absolute grid of hop samples, and several arrive per request, so the column spacing is hop/rate seconds regardless of this setting. A larger interval means fewer, larger messages, not a coarser picture."
        },
        "clamps.openReplOnStart": {
          "type": "boolean",
          "default": true,
          "description": "Opens the CLAMPS REPL terminal automatically once CLAMPS has started."
        },
        "clamps.compilerDiagnosticsOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Compiles saved Lisp files via Swank and shows compiler notes as problems/diagnostics."
        },
        "clamps.richPresentations": {
          "type": "boolean",
          "default": true,
          "description": "Shows stable object IDs for REPL results; does not change the text output."
        },
        "clamps.imageIndentation": {
          "type": "boolean",
          "default": true,
          "description": "Adds indentation rules from the running Lisp image."
        }
      }
    },
    "debuggers": [
      {
        "type": "clamps",
        "label": "CLAMPS (Common Lisp)",
        "languages": [
          "lisp"
        ],
        "configurationAttributes": {
          "attach": {
            "properties": {}
          }
        },
        "initialConfigurations": [
          {
            "type": "clamps",
            "request": "attach",
            "name": "CLAMPS: Attach Debugger"
          }
        ]
      }
    ],
    "menus": {
      "debug/variables/context": [
        {
          "command": "clamps.debugInspectVariable",
          "when": "debugType == clamps",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "clamps.debugInspectVariable",
          "when": "false"
        },
        {
          "command": "clamps.incudineRefreshSoon",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "clamps.incudineRefresh",
          "when": "view == clamps.incudineNodes",
          "group": "navigation"
        },
        {
          "command": "clamps.packagesRefresh",
          "when": "view == clamps.packages",
          "group": "navigation"
        },
        {
          "command": "clamps.classesRefresh",
          "when": "view == clamps.classes",
          "group": "navigation"
        },
        {
          "command": "clamps.threadsRefresh",
          "when": "view == clamps.threads",
          "group": "navigation"
        },
        {
          "command": "clamps.tracedRefresh",
          "when": "view == clamps.traced",
          "group": "navigation"
        },
        {
          "command": "clamps.xrefRefresh",
          "when": "view == clamps.xrefView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "clamps.incudineInspectNode",
          "when": "view == clamps.incudineNodes && viewItem == incudineNode"
        },
        {
          "command": "clamps.inspectBrowserItem",
          "when": "viewItem == clampsInspectable",
          "group": "navigation"
        },
        {
          "command": "clamps.untraceOne",
          "when": "view == clamps.traced",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "clamps.xrefDefinitions",
          "when": "editorLangId == lisp || editorLangId == commonlisp",
          "group": "navigation@1"
        },
        {
          "command": "clamps.xref",
          "when": "editorLangId == lisp || editorLangId == commonlisp",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "clamps",
          "title": "CLAMPS",
          "icon": "resources/clamps.svg"
        }
      ]
    },
    "views": {
      "clamps": [
        {
          "id": "clamps.xrefView",
          "name": "XREF"
        },
        {
          "id": "clamps.incudineNodes",
          "name": "Incudine Nodes"
        },
        {
          "id": "clamps.packages",
          "name": "Packages"
        },
        {
          "id": "clamps.classes",
          "name": "Classes"
        },
        {
          "id": "clamps.threads",
          "name": "Threads"
        },
        {
          "id": "clamps.traced",
          "name": "Trace & Breakpoints"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "python3 lisp/check.py",
    "comments:update": "node test/comments-update.js",
    "test": "node test/gatecoverage.test.js && node test/manifest.test.js && node test/hover.test.js && node test/debugger.test.js && node test/session.test.js && node test/features.test.js && node test/toplevel.test.js && node test/indentation.test.js && node test/paredit.test.js && node test/xref.test.js && node test/replcomplete.test.js && node test/stickerpoll.test.js && node test/freqscope.test.js && node test/spectrogram.test.js && node test/buffer.test.js && node test/ats.test.js && node test/lispstring.test.js && node test/comments.test.js",
    "gates": "npm run check && npm run lisp && npm run compile && npm test",
    "lisp": "sbcl --script lisp/loadcheck.lisp && sbcl --script lisp/framingtest.lisp && sbcl --script lisp/test-sticker-state.lisp && sbcl --script lisp/test-spectrum.lisp && sbcl --script lisp/test-buffer.lisp && sbcl --script lisp/test-ats.lisp && sbcl --script lisp/swankframing.lisp && sbcl --script lisp/test-xref.lisp && sbcl --script lisp/test-inspect.lisp && sbcl --script lisp/test-completion.lisp && sbcl --script lisp/test-bridge-context.lisp && sbcl --script lisp/test-fallback.lisp && sbcl --script lisp/test-autodoc.lisp",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish",
    "release:check": "npm run compile && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.85",
    "typescript": "5.4"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "license": "GPL-3.0-or-later",
  "icon": "resources/clamps-icon-256.png",
  "homepage": "https://github.com/Elvis-Budingensis/clamps-vscode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Elvis-Budingensis/clamps-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/Elvis-Budingensis/clamps-vscode/issues"
  },
  "keywords": [
    "common-lisp",
    "lisp",
    "clamps",
    "incudine",
    "audio",
    "dsp",
    "live-coding",
    "repl",
    "sbcl",
    "music"
  ]
}
