        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefBack",
        "title": "CLAMPS XREF: Back",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefForward",
        "title": "CLAMPS XREF: Forward",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.refreshIndentation",
