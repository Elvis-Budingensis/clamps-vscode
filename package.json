{
  "name": "clamps-vscode",
  "displayName": "CLAMPS – Audio-aware Lisp IDE",
  "description": "An audio-aware Lisp IDE for CLAMPS and Incudine.",
  "version": "1.1.3",
  "publisher": "elvis-budingensis",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/*.asd",
    "workspaceContains:**/*.lisp",
    "onLanguage:commonlisp",
    "onDebug"
  ],
  "main": "./out/extension.js",
