      },
      {
        "command": "clamps.xrefCallees",
        "title": "CLAMPS XREF: Callees",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefReferences",
        "title": "CLAMPS XREF: References",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefBindings",
        "title": "CLAMPS XREF: Bindings",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefSetters",
        "title": "CLAMPS XREF: Setters",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefMacroexpands",
        "title": "CLAMPS XREF: Macroexpansions",
        "category": "CLAMPS"
      },
      {
        "command": "clamps.xrefRefresh",
